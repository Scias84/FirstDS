<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="8dp">

    <!-- Controles Izquierdos (Cruceta D-Pad) -->
    <RelativeLayout
        android:id="@+id/dpad_container"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/dpad_0" />

        <View
            android:id="@+id/btn_up"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true" />

        <View
            android:id="@+id/btn_down"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true" />

        <View
            android:id="@+id/btn_left"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <View
            android:id="@+id/btn_right"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" />
    </RelativeLayout>

    <!-- Pantallas DS lado a lado al centro -->
    <LinearLayout
        android:id="@+id/screens_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/dpad_container"
        android:layout_toStartOf="@id/buttons_container"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp">

        <TextView
            android:id="@+id/screen_top"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="#000000"
            android:gravity="center"
            android:text="[ Pantalla Superior ]"
            android:textColor="#00FF66"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/screen_bottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#1E1E1E"
            android:gravity="center"
            android:text="[ Pantalla Táctil ]"
            android:textColor="#00E5FF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Controles Derechos (Botonera) -->
    <RelativeLayout
        android:id="@+id/buttons_container"
        android:layout_width="190dp"
        android:layout_height="160dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/padbuttons_0" />

        <View
            android:id="@+id/btn_a"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp" />

        <View
            android:id="@+id/btn_b"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentTop="true"
            android:layout_toEndOf="@id/btn_a"
            android:layout_marginStart="2dp" />

        <View
            android:id="@+id/btn_x"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_below="@id/btn_a"
            android:layout_alignParentStart="true"
            android:layout_marginStart="8dp" />

        <View
            android:id="@+id/btn_y"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_below="@id/btn_b"
            android:layout_toEndOf="@id/btn_x"
            android:layout_marginStart="2dp" />

        <View
            android:id="@+id/btn_l"
            android:layout_width="50dp"
            android:layout_height="28dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp" />

        <View
            android:id="@+id/btn_r"
            android:layout_width="50dp"
            android:layout_height="28dp"
            android:layout_below="@id/btn_l"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="2dp" />

        <View
            android:id="@+id/btn_start"
            android:layout_width="50dp"
            android:layout_height="22dp"
            android:layout_below="@id/btn_r"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="4dp" />

        <View
            android:id="@+id/btn_select"
            android:layout_width="50dp"
            android:layout_height="22dp"
            android:layout_below="@id/btn_start"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="2dp" />
    </RelativeLayout>

</RelativeLayout>
