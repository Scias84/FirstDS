<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Pantallas DS al fondo -->
    <LinearLayout
        android:id="@+id/screens_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="4dp">

        <TextView
            android:id="@+id/screen_top"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="#050505"
            android:gravity="center"
            android:text="[ Pantalla Superior ]"
            android:textColor="#00FF66"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/screen_bottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#0A0A0A"
            android:gravity="center"
            android:text="[ Pantalla Táctil ]"
            android:textColor="#00E5FF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- BOTÓN L (Esquina Superior Izquierda) -->
    <View
        android:id="@+id/btn_l"
        android:layout_width="95dp"
        android:layout_height="45dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp" />

    <!-- BOTÓN R (Esquina Superior Derecha) -->
    <View
        android:id="@+id/btn_r"
        android:layout_width="95dp"
        android:layout_height="45dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <!-- CRUCETA D-PAD (Esquina Inferior Izquierda) -->
    <RelativeLayout
        android:id="@+id/dpad_container"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/dpad_0" />

        <View
            android:id="@+id/btn_up"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="51dp"
            android:layout_marginTop="4dp" />

        <View
            android:id="@+id/btn_down"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="51dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="4dp" />

        <View
            android:id="@+id/btn_left"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="51dp" />

        <View
            android:id="@+id/btn_right"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="51dp" />
    </RelativeLayout>

    <!-- BOTONERA ABXY (Esquina Inferior Derecha) -->
    <RelativeLayout
        android:id="@+id/buttons_container"
        android:layout_width="170dp"
        android:layout_height="150dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/padbuttons_0" />

        <View
            android:id="@+id/btn_x"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp" />

        <View
            android:id="@+id/btn_y"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="20dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="12dp" />

        <View
            android:id="@+id/btn_a"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="20dp" />

        <View
            android:id="@+id/btn_b"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="12dp"
            android:layout_marginEnd="20dp" />
    </RelativeLayout>

    <!-- START Y SELECT (Abajo al Centro) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:id="@+id/btn_start"
            android:layout_width="55dp"
            android:layout_height="25dp"
            android:layout_marginEnd="10dp" />

        <View
            android:id="@+id/btn_select"
            android:layout_width="55dp"
            android:layout_height="25dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

</RelativeLayout>
