<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CAPA 1: JUEGO EN HORIZONTAL -->
    <RelativeLayout
        android:id="@+id/layout_emulator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/screens_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="2">

            <android.opengl.GLSurfaceView
                android:id="@+id/gl_screen_top"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp" />

            <android.opengl.GLSurfaceView
                android:id="@+id/gl_screen_bottom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_l"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp"
            android:text="L"
            android:textColor="#FFFFFF"
            android:backgroundTint="#33FFFFFF" />

        <Button
            android:id="@+id/btn_r"
            android:layout_width="70dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp"
            android:text="R"
            android:textColor="#FFFFFF"
            android:backgroundTint="#33FFFFFF" />

        <RelativeLayout
            android:id="@+id/dpad_layout"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp">

            <Button
                android:id="@+id/btn_up"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_down"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_left"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:backgroundTint="#44FFFFFF" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/action_buttons_layout"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp">

            <Button
                android:id="@+id/btn_x"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:text="X"
                android:textColor="#8F81B8"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_b"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:text="B"
                android:textColor="#4F357E"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_y"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:text="Y"
                android:textColor="#8F81B8"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_a"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:text="A"
                android:textColor="#4F357E"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_select"
                android:layout_width="70dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:text="SELECT"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#33FFFFFF" />

            <Button
                android:id="@+id/btn_start"
                android:layout_width="70dp"
                android:layout_height="32dp"
                android:text="START"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#33FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- CAPA 2: MENÚ SNES HORIZONTAL -->
    <RelativeLayout
        android:id="@+id/layout_main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp">

            <TextView
                android:id="@+id/btn_top_help"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="?"
                android:textColor="#8F81B8"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="::: "
                    android:textColor="#C2BFCC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First"
                    android:textColor="#4F357E"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DS"
                    android:textColor="#8F81B8"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" :::"
                    android:textColor="#C2BFCC"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_menu_continue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="continuar"
                    android:textColor="#C2BFCC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_menu_new_game"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="nuevo juego"
                    android:textColor="#2B2638"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_menu_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="opciones"
                    android:textColor="#4F357E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_menu_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="salir"
                    android:textColor="#2B2638"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- CAPA 3: OPCIONES HORIZONTAL -->
    <LinearLayout
        android:id="@+id/layout_options_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#4F357E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btn_options_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:background="#8F81B8"
                android:gravity="center"
                android:text="DS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configurar opciones"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/opt_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Vídeo"
                    android:textColor="#2B2638"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Audio"
                    android:textColor="#2B2638"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_virtual_pad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Mando de juego virtual"
                    android:textColor="#2B2638"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_external_pad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Controlador externo"
                    android:textColor="#2B2638"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="General"
                    android:textColor="#2B2638"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Sistema"
                    android:textColor="#2B2638"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="Avanzado"
                    android:textColor="#2B2638"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
