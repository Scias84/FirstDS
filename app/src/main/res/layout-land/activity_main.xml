<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- PANTALLAS DE NINTENDO DS (Centradas con espacio a los lados para los pulgares) -->
    <LinearLayout
        android:id="@+id/screens_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/dpad_container"
        app:layout_constraintEnd_toStartOf="@id/abxy_container">

        <TextView
            android:id="@+id/screen_top"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="#0A0A0A"
            android:gravity="center"
            android:text="[ Superior ]"
            android:textColor="#00FF66"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/screen_bottom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#121212"
            android:gravity="center"
            android:text="[ Táctil ]"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- GATILLOS L Y R (Esquinas superiores) -->
    <TextView
        android:id="@+id/btn_l"
        android:layout_width="100dp"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_pill"
        android:gravity="center"
        android:text="L"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_r"
        android:layout_width="100dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_pill"
        android:gravity="center"
        android:text="R"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CRUCETA D-PAD (Inferior Izquierda separada) -->
    <RelativeLayout
        android:id="@+id/dpad_container"
        android:layout_width="175dp"
        android:layout_height="175dp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/dpad_0" />

        <View
            android:id="@+id/btn_up"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentTop="true" />

        <View
            android:id="@+id/btn_down"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true" />

        <View
            android:id="@+id/btn_left"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true" />

        <View
            android:id="@+id/btn_right"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- ROMBO ABXY (Inferior Derecha separado) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/abxy_container"
        android:layout_width="175dp"
        android:layout_height="175dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_x"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_round"
            android:gravity="center"
            android:text="X"
            android:textColor="#3388FF"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btn_b"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_round"
            android:gravity="center"
            android:text="B"
            android:textColor="#FFDD33"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btn_y"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_round"
            android:gravity="center"
            android:text="Y"
            android:textColor="#33DD66"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/btn_a"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/btn_round"
            android:gravity="center"
            android:text="A"
            android:textColor="#FF4444"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- START Y SELECT (Centro inferior horizontal) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_select"
            android:layout_width="65dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_pill"
            android:gravity="center"
            android:text="SELECT"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_start"
            android:layout_width="65dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_pill"
            android:gravity="center"
            android:text="START"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
