<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Pantallas DS Arriba -->
    <LinearLayout
        android:id="@+id/screens_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="4dp">

        <TextView
            android:id="@+id/screen_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="2dp"
            android:background="#080808"
            android:gravity="center"
            android:text="[ Pantalla Superior ]"
            android:textColor="#00FF66"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/screen_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#121212"
            android:gravity="center"
            android:text="[ Pantalla Táctil ]"
            android:textColor="#00E5FF"
            android:textSize="14sp" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/controls_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.55" />

    <!-- D-PAD IZQUIERDO (Escalado Proporcional) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dpad_container"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/dpad_0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/btn_up"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.33"
            app:layout_constraintHeight_percent="0.33"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp" />

        <View
            android:id="@+id/btn_down"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.33"
            app:layout_constraintHeight_percent="0.33"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="4dp" />

        <View
            android:id="@+id/btn_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.33"
            app:layout_constraintHeight_percent="0.33"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="4dp" />

        <View
            android:id="@+id/btn_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.33"
            app:layout_constraintHeight_percent="0.33"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="4dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- BOTONERA DERECHA (Escalado Proporcional) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttons_container"
        android:layout_width="200dp"
        android:layout_height="170dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/padbuttons_0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- X, Y, A, B distribuidos proporcionalmente -->
        <View
            android:id="@+id/btn_x"
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="32dp" />

        <View
            android:id="@+id/btn_y"
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:layout_constraintTop_toBottomOf="@id/btn_x"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp" />

        <View
            android:id="@+id/btn_a"
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_x"
            android:layout_marginStart="14dp"
            android:layout_marginTop="32dp" />

        <View
            android:id="@+id/btn_b"
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:layout_constraintTop_toBottomOf="@id/btn_a"
            app:layout_constraintStart_toEndOf="@id/btn_y"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp" />

        <!-- L, R, Start, Select en la columna derecha de la imagen -->
        <View
            android:id="@+id/btn_l"
            android:layout_width="50dp"
            android:layout_height="25dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp" />

        <View
            android:id="@+id/btn_r"
            android:layout_width="50dp"
            android:layout_height="25dp"
            app:layout_constraintTop_toBottomOf="@id/btn_l"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp" />

        <View
            android:id="@+id/btn_start"
            android:layout_width="50dp"
            android:layout_height="22dp"
            app:layout_constraintTop_toBottomOf="@id/btn_r"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp" />

        <View
            android:id="@+id/btn_select"
            android:layout_width="50dp"
            android:layout_height="22dp"
            app:layout_constraintTop_toBottomOf="@id/btn_start"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
