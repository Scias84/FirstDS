<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CAPA 1: PANTALLA DE JUEGO (EMULADOR) -->
    <RelativeLayout
        android:id="@+id/layout_emulator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/screens_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <android.opengl.GLSurfaceView
                android:id="@+id/gl_screen_top"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_margin="2dp" />

            <android.opengl.GLSurfaceView
                android:id="@+id/gl_screen_bottom"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_margin="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_l"
            android:layout_width="75dp"
            android:layout_height="40dp"
            android:layout_below="@id/screens_container"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="L"
            android:textColor="#FFFFFF"
            android:backgroundTint="#33FFFFFF" />

        <Button
            android:id="@+id/btn_r"
            android:layout_width="75dp"
            android:layout_height="40dp"
            android:layout_below="@id/screens_container"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:text="R"
            android:textColor="#FFFFFF"
            android:backgroundTint="#33FFFFFF" />

        <RelativeLayout
            android:id="@+id/dpad_layout"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="40dp">

            <Button
                android:id="@+id/btn_up"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_down"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_left"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:backgroundTint="#44FFFFFF" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/action_buttons_layout"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="40dp">

            <Button
                android:id="@+id/btn_x"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:text="X"
                android:textColor="#8F81B8"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_b"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:text="B"
                android:textColor="#4F357E"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_y"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:text="Y"
                android:textColor="#8F81B8"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />

            <Button
                android:id="@+id/btn_a"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:text="A"
                android:textColor="#4F357E"
                android:textStyle="bold"
                android:backgroundTint="#44FFFFFF" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_select"
                android:layout_width="70dp"
                android:layout_height="34dp"
                android:layout_marginEnd="12dp"
                android:text="SELECT"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#33FFFFFF" />

            <Button
                android:id="@+id/btn_start"
                android:layout_width="70dp"
                android:layout_height="34dp"
                android:text="START"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#33FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- CAPA 2: MENÚ PRINCIPAL SNES -->
    <RelativeLayout
        android:id="@+id/layout_main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp">

            <TextView
                android:id="@+id/btn_top_help"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="?"
                android:textColor="#8F81B8"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="::: "
                    android:textColor="#C2BFCC"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First"
                    android:textColor="#4F357E"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DS"
                    android:textColor="#8F81B8"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" :::"
                    android:textColor="#C2BFCC"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="DS EMULATOR"
                android:textColor="#2B2638"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="40dp" />

            <TextView
                android:id="@+id/btn_menu_continue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="continuar"
                android:textColor="#C2BFCC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_menu_new_game"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="nuevo juego"
                android:textColor="#2B2638"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_menu_options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="opciones"
                android:textColor="#4F357E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_menu_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="salir"
                android:textColor="#2B2638"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="14dp"
            android:text="v1.0.0"
            android:textColor="#A29EAF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- CAPA 3: CONFIGURAR OPCIONES -->
    <LinearLayout
        android:id="@+id/layout_options_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#4F357E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/btn_options_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:background="#8F81B8"
                android:gravity="center"
                android:text="DS"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configurar opciones"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/opt_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:text="Vídeo"
                    android:textColor="#2B2638"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:text="Audio"
                    android:textColor="#2B2638"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_virtual_pad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:text="Mando de juego virtual"
                    android:textColor="#2B2638"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_external_pad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:text="Controlador externo"
                    android:textColor="#2B2638"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:text="General"
                    android:textColor="#2B2638"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:text="Sistema"
                    android:textColor="#2B2638"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

                <TextView
                    android:id="@+id/opt_advanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="18dp"
                    android:text="Avanzado"
                    android:textColor="#2B2638"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D1CFDB" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- CAPA 4: AJUSTES DE VÍDEO CON SELECTOR DE CONTROLADOR GPU -->
    <LinearLayout
        android:id="@+id/layout_video_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="ma
