<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:weightSum="10">

    <!-- Pantallas DS (Relación de aspecto 4:3 centradas) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.2"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <TextView
            android:id="@+id/screen_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="4dp"
            android:background="#000000"
            android:gravity="center"
            android:text="[ Pantalla Superior DS ]"
            android:textColor="#00FF66"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/screen_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1E1E1E"
            android:gravity="center"
            android:text="[ Pantalla Táctil DS ]"
            android:textColor="#00E5FF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Zona Inferior de Controles -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.8"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp">

        <!-- Cruceta D-Pad a la izquierda -->
        <RelativeLayout
            android:id="@+id/dpad_container"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/dpad_0" />

            <View
                android:id="@+id/btn_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true" />

            <View
                android:id="@+id/btn_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />

            <View
                android:id="@+id/btn_left"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <View
                android:id="@+id/btn_right"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Botonera Padbuttons a la derecha -->
        <RelativeLayout
            android:id="@+id/buttons_container"
            android:layout_width="175dp"
            android:layout_height="145dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/padbuttons_0" />

            <!-- Botones ABXY -->
            <View
                android:id="@+id/btn_a"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp" />

            <View
                android:id="@+id/btn_b"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_toEndOf="@id/btn_a"
                android:layout_marginStart="2dp" />

            <View
                android:id="@+id/btn_x"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_below="@id/btn_a"
                android:layout_alignParentStart="true"
                android:layout_marginStart="8dp" />

            <View
                android:id="@+id/btn_y"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_below="@id/btn_b"
                android:layout_toEndOf="@id/btn_x"
                android:layout_marginStart="2dp" />

            <!-- Gatillos L y R del skin -->
            <View
                android:id="@+id/btn_l"
                android:layout_width="45dp"
                android:layout_height="25dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="15dp" />

            <View
                android:id="@+id/btn_r"
                android:layout_width="45dp"
                android:layout_height="25dp"
                android:layout_below="@id/btn_l"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="2dp" />

            <!-- Start y Select del skin -->
            <View
                android:id="@+id/btn_start"
                android:layout_width="45dp"
                android:layout_height="20dp"
                android:layout_below="@id/btn_r"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="3dp" />

            <View
                android:id="@+id/btn_select"
                android:layout_width="45dp"
                android:layout_height="20dp"
                android:layout_below="@id/btn_start"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="2dp" />
        </RelativeLayout>

    </RelativeLayout>

</LinearLayout>
