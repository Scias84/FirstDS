<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Pantallas DS Arriba (Apiladas una sobre otra) -->
    <LinearLayout
        android:id="@+id/screens_container"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/screen_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="2dp"
            android:background="#050505"
            android:gravity="center"
            android:text="[ Pantalla Superior ]"
            android:textColor="#00FF66"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/screen_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0A0A0A"
            android:gravity="center"
            android:text="[ Pantalla Táctil ]"
            android:textColor="#00E5FF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Zona de Controles Inferior -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/screens_container">

        <!-- Cruceta D-PAD (Esquina Inferior Izquierda) -->
        <RelativeLayout
            android:id="@+id/dpad_container"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/dpad_0" />

            <View
                android:id="@+id/btn_up"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="54dp"
                android:layout_marginTop="6dp" />

            <View
                android:id="@+id/btn_down"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="54dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="6dp" />

            <View
                android:id="@+id/btn_left"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="54dp" />

            <View
                android:id="@+id/btn_right"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="54dp" />
        </RelativeLayout>

        <!-- Botonera ABXY (Esquina Inferior Derecha) -->
        <RelativeLayout
            android:id="@+id/buttons_container"
            android:layout_width="190dp"
            android:layout_height="160dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/padbuttons_0" />

            <View
                android:id="@+id/btn_x"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="48dp" />

            <View
                android:id="@+id/btn_y"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="98dp" />

            <View
                android:id="@+id/btn_a"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="68dp"
                android:layout_marginTop="48dp" />

            <View
                android:id="@+id/btn_b"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginStart="68dp"
                android:layout_marginTop="98dp" />

            <View
                android:id="@+id/btn_l"
                android:layout_width="50dp"
                android:layout_height="28dp"
                android:layout_marginStart="122dp"
                android:layout_marginTop="12dp" />

            <View
                android:id="@+id/btn_r"
                android:layout_width="50dp"
                android:layout_height="28dp"
                android:layout_marginStart="122dp"
                android:layout_marginTop="45dp" />

            <View
                android:id="@+id/btn_start"
                android:layout_width="50dp"
                android:layout_height="22dp"
                android:layout_marginStart="122dp"
                android:layout_marginTop="85dp" />

            <View
                android:id="@+id/btn_select"
                android:layout_width="50dp"
                android:layout_height="22dp"
                android:layout_marginStart="122dp"
                android:layout_marginTop="115dp" />
        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>
