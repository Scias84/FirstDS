<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. PANTALLA DE JUEGO (EMULADOR) -->
    <RelativeLayout
        android:id="@+id/layout_emulator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/screens_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <android.opengl.GLSurfaceView
                android:id="@+id/gl_screen_top"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_margin="2dp" />
            <android.opengl.GLSurfaceView
                android:id="@+id/gl_screen_bottom"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_margin="2dp" />
        </LinearLayout>

        <Button android:id="@+id/btn_l" android:layout_width="70dp" android:layout_height="40dp" android:layout_below="@id/screens_container" android:layout_alignParentStart="true" android:layout_margin="12dp" android:text="L" android:textColor="#FFF" android:backgroundTint="#33FFFFFF" />
        <Button android:id="@+id/btn_r" android:layout_width="70dp" android:layout_height="40dp" android:layout_below="@id/screens_container" android:layout_alignParentEnd="true" android:layout_margin="12dp" android:text="R" android:textColor="#FFF" android:backgroundTint="#33FFFFFF" />

        <RelativeLayout android:id="@+id/dpad_layout" android:layout_width="130dp" android:layout_height="130dp" android:layout_alignParentStart="true" android:layout_alignParentBottom="true" android:layout_margin="16dp">
            <Button android:id="@+id/btn_up" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:backgroundTint="#44FFFFFF" />
            <Button android:id="@+id/btn_down" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:backgroundTint="#44FFFFFF" />
            <Button android:id="@+id/btn_left" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:backgroundTint="#44FFFFFF" />
            <Button android:id="@+id/btn_right" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:backgroundTint="#44FFFFFF" />
        </RelativeLayout>

        <RelativeLayout android:id="@+id/action_buttons_layout" android:layout_width="130dp" android:layout_height="130dp" android:layout_alignParentEnd="true" android:layout_alignParentBottom="true" android:layout_margin="16dp">
            <Button android:id="@+id/btn_x" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerHorizontal="true" android:layout_alignParentTop="true" android:text="X" android:textColor="#8F81B8" android:textStyle="bold" android:backgroundTint="#44FFFFFF" />
            <Button android:id="@+id/btn_b" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerHorizontal="true" android:layout_alignParentBottom="true" android:text="B" android:textColor="#4F357E" android:textStyle="bold" android:backgroundTint="#44FFFFFF" />
            <Button android:id="@+id/btn_y" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:text="Y" android:textColor="#8F81B8" android:textStyle="bold" android:backgroundTint="#44FFFFFF" />
            <Button android:id="@+id/btn_a" android:layout_width="42dp" android:layout_height="42dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:text="A" android:textColor="#4F357E" android:textStyle="bold" android:backgroundTint="#44FFFFFF" />
        </RelativeLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:layout_marginBottom="12dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_select" android:layout_width="65dp" android:layout_height="32dp" android:layout_marginEnd="10dp" android:text="SELECT" android:textSize="8sp" android:textColor="#FFF" android:backgroundTint="#33FFFFFF" />
            <Button android:id="@+id/btn_start" android:layout_width="65dp" android:layout_height="32dp" android:text="START" android:textSize="8sp" android:textColor="#FFF" android:backgroundTint="#33FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. MENÚ PRINCIPAL SNES -->
    <RelativeLayout
        android:id="@+id/layout_main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:clickable="true"
        android:focusable="true">

        <TextView android:id="@+id/btn_top_help" android:layout_width="36dp" android:layout_height="36dp" android:layout_alignParentTop="true" android:layout_alignParentEnd="true" android:layout_margin="16dp" android:gravity="center" android:text="?" android:textColor="#8F81B8" android:textSize="22sp" android:textStyle="bold" />

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="::: FirstDS :::" android:textColor="#4F357E" android:textSize="40sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.2" android:text="DS EMULATOR" android:textColor="#2B2638" android:textSize="14sp" android:textStyle="bold" />
            <View android:layout_width="1dp" android:layout_height="30dp" />
            <TextView android:id="@+id/btn_menu_continue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="continuar" android:textColor="#C2BFCC" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/btn_menu_new_game" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="nuevo juego" android:textColor="#2B2638" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/btn_menu_options" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="opciones" android:textColor="#4F357E" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/btn_menu_exit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="salir" android:textColor="#2B2638" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 3. CONFIGURAR OPCIONES (LISTA PRINCIPAL) -->
    <LinearLayout
        android:id="@+id/layout_options_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#4F357E" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
            <TextView android:id="@+id/btn_options_back" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="←" android:textColor="#FFF" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Configurar opciones" android:textColor="#FFF" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/opt_video" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Vídeo" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
                <TextView android:id="@+id/opt_audio" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Audio" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
                <TextView android:id="@+id/opt_virtual_pad" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Mando de juego virtual" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
                <TextView android:id="@+id/opt_external_pad" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Controlador externo" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
                <TextView android:id="@+id/opt_general" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="General" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
                <TextView android:id="@+id/opt_system" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Sistema" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
                <TextView android:id="@+id/opt_advanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Avanzado" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 4. AJUSTES DE VÍDEO -->
    <LinearLayout
        android:id="@+id/layout_video_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#4F357E" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
            <TextView android:id="@+id/btn_video_back" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="←" android:textColor="#FFF" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Ajustes de vídeo" android:textColor="#FFF" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/opt_video_backend" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Motor gráfico (Backend)" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txt_backend_selected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OpenGL ES 3.2" android:textColor="#4F357E" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

                <LinearLayout android:id="@+id/opt_video_driver" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Controlador GPU (Driver Vulkan)" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txt_driver_selected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Controlador del sistema (Predeterminado)" android:textColor="#4F357E" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:text="Renderizado 3D alta resolución" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <Switch android:id="@+id/switch_hires_3d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:checked="true" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:text="Renderizado 3D multihilado" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <Switch android:id="@+id/switch_multithread_3d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:checked="true" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

                <LinearLayout android:id="@+id/opt_video_frameskip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Omisión de fotogramas" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automático" android:textColor="#4F357E" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 5. AJUSTES DE MANDO DE JUEGO VIRTUAL -->
    <LinearLayout
        android:id="@+id/layout_virtual_pad_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EFF5"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="#4F357E" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
            <TextView android:id="@+id/btn_vpad_back" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="←" android:textColor="#FFF" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Mando de juego virtual" android:textColor="#FFF" android:textSize="18sp" android:textStyle="bold" />
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <LinearLayout android:id="@+id/opt_vpad_opacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opacidad del mando" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txt_vpad_opacity_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="70% (Semivisible)" android:textColor="#4F357E" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_toStartOf="@+id/switch_vpad_vibration" android:layout_marginEnd="12dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vibración al pulsar botones" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Respuesta háptica al tocar la cruceta o botones" android:textColor="#787588" android:textSize="12sp" />
                    </LinearLayout>
                    <Switch android:id="@+id/switch_vpad_vibration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:checked="true" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

                <LinearLayout android:id="@+id/opt_vpad_style" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Estilo de botones virtuales" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/txt_vpad_style_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Super Nintendo (Morado / Lavanda)" android:textColor="#4F357E" android:textSize="13sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

                <LinearLayout android:id="@+id/opt_vpad_layout_edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Editar disposición y tamaño de controles" android:textColor="#2B2638" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mueve y redimensiona los botones en pantalla" android:textColor="#787588" android:textSize="12sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#D1CFDB" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
